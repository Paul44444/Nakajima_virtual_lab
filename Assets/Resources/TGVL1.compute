//27092026 TGV-L1-Loeser einer Pyramidenstufe (Alternative zu TVL1.compute, umschaltbar; TVL1.compute bleibt
//  unveraendert). Datenterm und Warp wie TV-L1 (Kopie von KWarp/KReduce/Bicubic aus TVL1.compute):
//    v = Schwellwertschritt(u)                          (gleiche Formeln wie KStepA, lambda*theta)
//  Glaettung statt Chambolle-TV: ein Primal-Dual-Schritt (Chambolle-Pock) je Iteration fuer
//    min_{u,w} 1/(2 theta) |u - v|^2 + alpha1 |grad u - w| + alpha0 |eps(w)|        (je Flusskomponente)
//  eps(w) = symmetrischer Gradient von w = (w1, w2); |q| = sqrt(q11^2 + q22^2 + 2 q12^2).
//  Mit alpha1 = 1 entspricht die Gewichtung von |grad u| der bisherigen TV; alpha0 -> unendlich ergibt TV.
//  Diskretisierung wie TV: Vorwaertsdifferenzen (0 am rechten/unteren Rand), Divergenz = negatives Adjungiertes
//  mit denselben Randregeln wie divergence(). Schrittweiten tau = sigma = 1/sqrt(12) (||K||^2 <= 12).
//  Kernels je Iteration: KTgvData, KTgvDualP, KTgvDualQ, KTgvPrimalU (Fehler-Teilsummen), KTgvPrimalW, KReduce.
//  Nach "done" kehren alle Kernels sofort zurueck (wie TVL1.compute). Hoechstens 8 UAVs je Kernel.

#pragma kernel KWarp
#pragma kernel KReduce
#pragma kernel KTgvData
#pragma kernel KTgvDualP
#pragma kernel KTgvDualQ
#pragma kernel KTgvPrimalU
#pragma kernel KTgvPrimalW

#define GROUP 256

int nx;
int ny;
int size_px;
int num_groups;
int warp_idx;
float l_t;          // lambda * theta
float theta;
float eps_sq;       // epsilon^2
float grad_is_zero; // GRAD_IS_ZERO
float tgv_tau;      // primaler Schritt
float tgv_sigma;    // dualer Schritt
float alpha0;       // Gewicht |eps(w)|
float alpha1;       // Gewicht |grad u - w|

// KWarp
StructuredBuffer<float> I0_r;
StructuredBuffer<float> I1_r;
StructuredBuffer<float> I1x_r;
StructuredBuffer<float> I1y_r;
RWStructuredBuffer<float> I1wx;
RWStructuredBuffer<float> I1wy;
RWStructuredBuffer<float> Grad;
RWStructuredBuffer<float> RhoC;

// gelesen
StructuredBuffer<float> I1wx_r;
StructuredBuffer<float> I1wy_r;
StructuredBuffer<float> Grad_r;
StructuredBuffer<float> RhoC_r;
StructuredBuffer<float> U1_r;
StructuredBuffer<float> U2_r;
StructuredBuffer<float> V1_r;
StructuredBuffer<float> V2_r;
StructuredBuffer<float> Ub1_r;
StructuredBuffer<float> Ub2_r;
StructuredBuffer<float> P11_r;
StructuredBuffer<float> P12_r;
StructuredBuffer<float> P21_r;
StructuredBuffer<float> P22_r;
StructuredBuffer<float> Wb11_r;
StructuredBuffer<float> Wb12_r;
StructuredBuffer<float> Wb21_r;
StructuredBuffer<float> Wb22_r;
StructuredBuffer<float> Q1a_r; // Komponente 1: q11
StructuredBuffer<float> Q1b_r; //               q22
StructuredBuffer<float> Q1c_r; //               q12
StructuredBuffer<float> Q2a_r;
StructuredBuffer<float> Q2b_r;
StructuredBuffer<float> Q2c_r;
StructuredBuffer<float> Partial_r;
StructuredBuffer<uint> State_r;

// geschrieben
RWStructuredBuffer<float> V1;
RWStructuredBuffer<float> V2;
RWStructuredBuffer<float> P11;
RWStructuredBuffer<float> P12;
RWStructuredBuffer<float> P21;
RWStructuredBuffer<float> P22;
RWStructuredBuffer<float> Q1a;
RWStructuredBuffer<float> Q1b;
RWStructuredBuffer<float> Q1c;
RWStructuredBuffer<float> Q2a;
RWStructuredBuffer<float> Q2b;
RWStructuredBuffer<float> Q2c;
RWStructuredBuffer<float> U1;
RWStructuredBuffer<float> U2;
RWStructuredBuffer<float> Ub1;
RWStructuredBuffer<float> Ub2;
RWStructuredBuffer<float> W11;
RWStructuredBuffer<float> W12;
RWStructuredBuffer<float> W21;
RWStructuredBuffer<float> W22;
RWStructuredBuffer<float> Wb11;
RWStructuredBuffer<float> Wb12;
RWStructuredBuffer<float> Wb21;
RWStructuredBuffer<float> Wb22;
RWStructuredBuffer<float> Partial;
RWStructuredBuffer<uint> State;    // [0] = done, [1] = Iterationen
RWStructuredBuffer<float> ErrOut;

groupshared float gs_sum[GROUP];

// ---------------------------------------------------------------- Bicubic (wie TVL1.compute)

bool is_nan_bits(float x)
{
    return (asuint(x) & 0x7fffffffu) > 0x7f800000u;
}

float fetch0(StructuredBuffer<float> img, int x, int y)
{
    float val = img[x + nx * y];
    return is_nan_bits(val) ? 0.0f : val;
}

int neumann_bc(int x, int n, inout bool out_flag)
{
    if (x < 0) { x = 0; out_flag = true; }
    else if (x >= n) { x = n - 1; out_flag = true; }
    return x;
}

float cubic_cell(float v0, float v1, float v2, float v3, float x)
{
    return v1 + 0.5f * x * (v2 - v0 +
        x * (2.0f * v0 - 5.0f * v1 + 4.0f * v2 - v3 +
        x * (3.0f * (v1 - v2) + v3 - v0)));
}

float bicubic_at(StructuredBuffer<float> img, float uu, float vv)
{
    int sx = (uu < 0.0f) ? -1 : 1;
    int sy = (vv < 0.0f) ? -1 : 1;
    int iu = (int)uu;
    int iv = (int)vv;

    bool out_flag = false;
    int x   = neumann_bc(iu, nx, out_flag);
    int y   = neumann_bc(iv, ny, out_flag);
    int mx  = neumann_bc(iu - sx, nx, out_flag);
    int my  = neumann_bc(iv - sy, ny, out_flag);
    int dx  = neumann_bc(iu + sx, nx, out_flag);
    int dy  = neumann_bc(iv + sy, ny, out_flag);
    int ddx = neumann_bc(iu + 2 * sx, nx, out_flag);
    int ddy = neumann_bc(iv + 2 * sy, ny, out_flag);

    if (out_flag)
        return 0.0f;

    float fx = uu - (float)x;
    float fy = vv - (float)y;

    float c0 = cubic_cell(fetch0(img, mx, my),  fetch0(img, mx, y),  fetch0(img, mx, dy),  fetch0(img, mx, ddy),  fy);
    float c1 = cubic_cell(fetch0(img, x, my),   fetch0(img, x, y),   fetch0(img, x, dy),   fetch0(img, x, ddy),   fy);
    float c2 = cubic_cell(fetch0(img, dx, my),  fetch0(img, dx, y),  fetch0(img, dx, dy),  fetch0(img, dx, ddy),  fy);
    float c3 = cubic_cell(fetch0(img, ddx, my), fetch0(img, ddx, y), fetch0(img, ddx, dy), fetch0(img, ddx, ddy), fy);
    return cubic_cell(c0, c1, c2, c3, fx);
}

// ---------------------------------------------------------------- Differenzenoperatoren

// Vorwaertsdifferenzen, 0 am rechten/unteren Rand (wie forward_gradient)
float fwd_x(StructuredBuffer<float> f, int p, int j) { return (j < nx - 1) ? (f[p + 1] - f[p]) : 0.0f; }
float fwd_y(StructuredBuffer<float> f, int p, int i) { return (i < ny - 1) ? (f[p + nx] - f[p]) : 0.0f; }

// Rueckwaertsdifferenzen mit den Randregeln von divergence() (negatives Adjungiertes von fwd_*)
float bwd_x(StructuredBuffer<float> f, int p, int j) { return (j == 0) ? f[p] : ((j == nx - 1) ? -f[p - 1] : (f[p] - f[p - 1])); }
float bwd_y(StructuredBuffer<float> f, int p, int i) { return (i == 0) ? f[p] : ((i == ny - 1) ? -f[p - nx] : (f[p] - f[p - nx])); }

// ---------------------------------------------------------------- Kernels

[numthreads(GROUP, 1, 1)]
void KWarp(uint3 id : SV_DispatchThreadID)
{
    int p = (int)id.x;
    if (p >= size_px)
        return;
    int i = (int)((uint)p / (uint)nx);
    int j = p - i * nx;

    float u1 = U1_r[p];
    float u2 = U2_r[p];
    float uu = (float)j + u1;
    float vv = (float)i + u2;

    float w  = bicubic_at(I1_r, uu, vv);
    float wx = bicubic_at(I1x_r, uu, vv);
    float wy = bicubic_at(I1y_r, uu, vv);

    I1wx[p] = wx;
    I1wy[p] = wy;
    Grad[p] = wx * wx + wy * wy;
    RhoC[p] = w - wx * u1 - wy * u2 - I0_r[p];
}

// Datenterm: Schwellwertschritt wie KStepA in TVL1.compute
[numthreads(GROUP, 1, 1)]
void KTgvData(uint3 id : SV_DispatchThreadID)
{
    if (State_r[0] != 0u)
        return;
    int p = (int)id.x;
    if (p >= size_px)
        return;

    float u1 = U1_r[p];
    float u2 = U2_r[p];
    float wx = I1wx_r[p];
    float wy = I1wy_r[p];
    float g  = Grad_r[p];

    float rho = RhoC_r[p] + (wx * u1 + wy * u2);
    float d1, d2;
    if (rho < -l_t * g)
    {
        d1 = l_t * wx;
        d2 = l_t * wy;
    }
    else if (rho > l_t * g)
    {
        d1 = -l_t * wx;
        d2 = -l_t * wy;
    }
    //29092026 Bugfix: Schutz vor g = 0 in jedem Warp (wie IPOL), sonst NaN in gleichmaessigen Flaechen
    else if (g < grad_is_zero)
    {
        d1 = 0.0f;
        d2 = 0.0f;
    }
    else
    {
        float fi = -rho / g;
        d1 = fi * wx;
        d2 = fi * wy;
    }
    V1[p] = u1 + d1;
    V2[p] = u2 + d2;
}

// dual p <- proj_{alpha1}( p + sigma (grad ubar - wbar) )
[numthreads(GROUP, 1, 1)]
void KTgvDualP(uint3 id : SV_DispatchThreadID)
{
    if (State_r[0] != 0u)
        return;
    int p = (int)id.x;
    if (p >= size_px)
        return;
    int i = (int)((uint)p / (uint)nx);
    int j = p - i * nx;

    float a1 = P11[p] + tgv_sigma * (fwd_x(Ub1_r, p, j) - Wb11_r[p]);
    float b1 = P12[p] + tgv_sigma * (fwd_y(Ub1_r, p, i) - Wb12_r[p]);
    float n1 = max(1.0f, sqrt(a1 * a1 + b1 * b1) / alpha1);
    P11[p] = a1 / n1;
    P12[p] = b1 / n1;

    float a2 = P21[p] + tgv_sigma * (fwd_x(Ub2_r, p, j) - Wb21_r[p]);
    float b2 = P22[p] + tgv_sigma * (fwd_y(Ub2_r, p, i) - Wb22_r[p]);
    float n2 = max(1.0f, sqrt(a2 * a2 + b2 * b2) / alpha1);
    P21[p] = a2 / n2;
    P22[p] = b2 / n2;
}

// dual q <- proj_{alpha0}( q + sigma eps(wbar) ), eps(w) = (dx w1, dy w2, 1/2 (dy w1 + dx w2))
[numthreads(GROUP, 1, 1)]
void KTgvDualQ(uint3 id : SV_DispatchThreadID)
{
    if (State_r[0] != 0u)
        return;
    int p = (int)id.x;
    if (p >= size_px)
        return;
    int i = (int)((uint)p / (uint)nx);
    int j = p - i * nx;

    float a = Q1a[p] + tgv_sigma * fwd_x(Wb11_r, p, j);
    float b = Q1b[p] + tgv_sigma * fwd_y(Wb12_r, p, i);
    float c = Q1c[p] + tgv_sigma * 0.5f * (fwd_y(Wb11_r, p, i) + fwd_x(Wb12_r, p, j));
    float n = max(1.0f, sqrt(a * a + b * b + 2.0f * c * c) / alpha0);
    Q1a[p] = a / n; Q1b[p] = b / n; Q1c[p] = c / n;

    a = Q2a[p] + tgv_sigma * fwd_x(Wb21_r, p, j);
    b = Q2b[p] + tgv_sigma * fwd_y(Wb22_r, p, i);
    c = Q2c[p] + tgv_sigma * 0.5f * (fwd_y(Wb21_r, p, i) + fwd_x(Wb22_r, p, j));
    n = max(1.0f, sqrt(a * a + b * b + 2.0f * c * c) / alpha0);
    Q2a[p] = a / n; Q2b[p] = b / n; Q2c[p] = c / n;
}

// primal u <- (u + tau div p + tau/theta v) / (1 + tau/theta); ubar = 2 u_neu - u_alt; Fehler-Teilsummen
[numthreads(GROUP, 1, 1)]
void KTgvPrimalU(uint3 id : SV_DispatchThreadID, uint3 gid : SV_GroupID, uint gi : SV_GroupIndex)
{
    if (State_r[0] != 0u)
        return; // gleichmaessig fuer alle Threads

    int p = (int)id.x;
    float contrib = 0.0f;
    if (p < size_px)
    {
        int i = (int)((uint)p / (uint)nx);
        int j = p - i * nx;
        float k = tgv_tau / theta;

        float u1 = U1[p];
        float div1 = bwd_x(P11_r, p, j) + bwd_y(P12_r, p, i);
        float u1n = (u1 + tgv_tau * div1 + k * V1_r[p]) / (1.0f + k);
        U1[p] = u1n;
        Ub1[p] = 2.0f * u1n - u1;

        float u2 = U2[p];
        float div2 = bwd_x(P21_r, p, j) + bwd_y(P22_r, p, i);
        float u2n = (u2 + tgv_tau * div2 + k * V2_r[p]) / (1.0f + k);
        U2[p] = u2n;
        Ub2[p] = 2.0f * u2n - u2;

        contrib = (u1n - u1) * (u1n - u1) + (u2n - u2) * (u2n - u2);
    }

    gs_sum[gi] = contrib;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint s = GROUP / 2; s > 0; s >>= 1)
    {
        if (gi < s)
            gs_sum[gi] += gs_sum[gi + s];
        GroupMemoryBarrierWithGroupSync();
    }
    if (gi == 0)
        Partial[gid.x] = gs_sum[0];
}

// primal w <- w + tau (p + div2 q); wbar = 2 w_neu - w_alt
// div2 q = (bwd_x q11 + bwd_y q12, bwd_x q12 + bwd_y q22)
[numthreads(GROUP, 1, 1)]
void KTgvPrimalW(uint3 id : SV_DispatchThreadID)
{
    if (State_r[0] != 0u)
        return;
    int p = (int)id.x;
    if (p >= size_px)
        return;
    int i = (int)((uint)p / (uint)nx);
    int j = p - i * nx;

    float w, wn;
    w = W11[p]; wn = w + tgv_tau * (P11_r[p] + bwd_x(Q1a_r, p, j) + bwd_y(Q1c_r, p, i)); W11[p] = wn; Wb11[p] = 2.0f * wn - w;
    w = W12[p]; wn = w + tgv_tau * (P12_r[p] + bwd_x(Q1c_r, p, j) + bwd_y(Q1b_r, p, i)); W12[p] = wn; Wb12[p] = 2.0f * wn - w;
    w = W21[p]; wn = w + tgv_tau * (P21_r[p] + bwd_x(Q2a_r, p, j) + bwd_y(Q2c_r, p, i)); W21[p] = wn; Wb21[p] = 2.0f * wn - w;
    w = W22[p]; wn = w + tgv_tau * (P22_r[p] + bwd_x(Q2c_r, p, j) + bwd_y(Q2b_r, p, i)); W22[p] = wn; Wb22[p] = 2.0f * wn - w;
}

[numthreads(GROUP, 1, 1)]
void KReduce(uint gi : SV_GroupIndex)
{
    float acc = 0.0f;
    for (int k = (int)gi; k < num_groups; k += GROUP)
        acc += Partial_r[k];
    gs_sum[gi] = acc;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint s = GROUP / 2; s > 0; s >>= 1)
    {
        if (gi < s)
            gs_sum[gi] += gs_sum[gi + s];
        GroupMemoryBarrierWithGroupSync();
    }
    if (gi == 0 && State[0] == 0u)
    {
        float err = gs_sum[0] / (float)size_px;
        ErrOut[0] = err;
        State[1] = State[1] + 1u;
        if (!(err > eps_sq))
            State[0] = 1u;
    }
}

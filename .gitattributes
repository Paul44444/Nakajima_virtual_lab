# Unity YAML and text files: keep line endings as committed
*.cs       text
*.py       text
*.md       text
*.json     text
*.compute  text
*.unity    text merge=unityyamlmerge -diff
*.prefab   text merge=unityyamlmerge -diff
*.asset    text merge=unityyamlmerge -diff
*.meta     text -diff
*.tsv      text

# binary
*.png      binary
*.fbx      binary
*.ttf      binary
*.pdf      binary
